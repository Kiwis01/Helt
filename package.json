{
  "name": "loop",
  "version": "0.1.0",
  "private": true,
  "description": "Loop — closed-loop voice companion for chronic anxiety. YC x Medplum hackathon.",
  "license": "MIT",
  "workspaces": [
    "shared",
    "voice",
    "coverage",
    "dashboard"
  ],
  "scripts": {
    "fixtures:generate": "node shared/fixtures/generate.mjs",
    "fixtures:validate": "npm run validate --workspace @loop/shared",
    "dev": "concurrently -n voice,coverage,dashboard -c yellow,cyan,magenta \"npm:dev:voice\" \"npm:dev:coverage\" \"npm:dev:dashboard\"",
    "dev:voice": "npm run dev --workspace loop-voice",
    "dev:coverage": "npm run dev --workspace @loop/coverage",
    "dev:dashboard": "npm run dev --workspace @loop/dashboard",
    "build": "npm run build --workspace @loop/coverage && npm run build --workspace @loop/dashboard && npm run build --workspace loop-voice",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "redflag": "npm run redflag --workspace loop-voice --",
    "smoke": "npm run smoke --workspace @loop/coverage",
    "smoke:voice": "npm run smoke --workspace loop-voice"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
