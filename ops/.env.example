# =============================================================================
#  Loop — variables de entorno compartidas.
#
#    cp ops/.env.example .env
#
#  Los nombres son idénticos en los cuatro servicios. Si cambias uno, cámbialo
#  también en los otros briefs — está en la sección 3 de los tres planes.
#  El `.env` real NUNCA se commitea. Este archivo va siempre sin secretos.
# =============================================================================

# ------------------------------------------------------------------
# La palanca de integración
# ------------------------------------------------------------------
# true  → cada servicio lee de shared/fixtures/ en vez de llamar a los otros.
#         Nadie se bloquea esperando a que otro termine.
# false → llamadas HTTP reales entre servicios. Solo se apaga poniendo
#         literalmente `false`.
USE_MOCKS=true

# ------------------------------------------------------------------
# Medplum (Kiwis · loop-core :3001)
# ------------------------------------------------------------------
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
# Project ID de Medplum donde viven Patient, CarePlan y Encounter.
MEDPLUM_PROJECT_ID=

# ------------------------------------------------------------------
# Deepgram (Lewis · loop-voice :3002)
# ------------------------------------------------------------------
# API key de Deepgram. Se usa en el SERVIDOR, nunca se expone al browser.
DEEPGRAM_API_KEY=
# Modelo de STT (Listen WebSocket). Default en código: nova-3.
DG_STT_MODEL=
# Idioma de STT. Default en código: multi (detecta español e inglés).
DG_STT_LANGUAGE=
# Voz de TTS (Aura-2). Default en código: aura-2-selena-es.
DG_TTS_VOICE=

# ------------------------------------------------------------------
# AWS (Lewis · Bedrock para el LLM, Polly como TTS de respaldo)
# ------------------------------------------------------------------
# Región de AWS para Bedrock y Polly. Default en código: us-east-1.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo si son credenciales temporales.
AWS_SESSION_TOKEN=
# Inference-profile ID de Bedrock que usa el agente. Nunca se hardcodea.
AGENT_MODEL_ID=
# Voz de AWS Polly para el fallback de TTS. Default en código: Lupe.
POLLY_VOICE=
# Motor de Polly. Default en código: generative.
POLLY_ENGINE=

# ------------------------------------------------------------------
# Anthropic (camino alternativo; el primario de voice es Bedrock)
# ------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------
# Stedi (Carlos · loop-coverage :3003)
# ------------------------------------------------------------------
# Sin STEDI_API_KEY el servicio arranca igual, en modo mock, y lo dice en
# /healthz. Eso es deliberado: nadie debe quedarse bloqueado esperando el
# alta de Stedi.
STEDI_API_KEY=
STEDI_ENV=sandbox

# Payer y miembro de prueba del sandbox. Sale de la consola de Stedi.
STEDI_TEST_PAYER_ID=
STEDI_TEST_PAYER_NAME=Test Payer Inc
STEDI_TEST_MEMBER_ID=
STEDI_TEST_MEMBER_FIRST_NAME=Alex
STEDI_TEST_MEMBER_LAST_NAME=Rivera
STEDI_TEST_MEMBER_DOB=1992-03-14

# NPI del proveedor que hace la consulta de elegibilidad.
STEDI_PROVIDER_NPI=1999999984
STEDI_PROVIDER_ORG_NAME=Loop Health Demo

# ------------------------------------------------------------------
# URLs entre servicios
# ------------------------------------------------------------------
LOOP_CORE_URL=http://localhost:3001
LOOP_VOICE_URL=http://localhost:3002
LOOP_COVERAGE_URL=http://localhost:3003

# El dashboard corre en el navegador: necesita el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_LOOP_CORE_URL=http://localhost:3001
NEXT_PUBLIC_LOOP_VOICE_URL=http://localhost:3002
NEXT_PUBLIC_LOOP_COVERAGE_URL=http://localhost:3003

# Modo respaldo del dashboard: si el wifi del hackathon muere, se pone en
# true y toda la vista corre desde shared/fixtures/.
NEXT_PUBLIC_USE_FIXTURES=false

# ------------------------------------------------------------------
# Puertos y logging de loop-voice
# ------------------------------------------------------------------
# loop-voice IGNORA la variable genérica `PORT` a propósito: en el .env real
# vale 8787 para otro proceso. Default en código: 3002.
VOICE_PORT=
# Host de bind de loop-voice. Default en código: 0.0.0.0
VOICE_HOST=
# Nivel de log de loop-voice. Default en código: info
LOG_LEVEL=

# ------------------------------------------------------------------
# Timeouts de llamadas salientes de loop-voice (ms)
# ------------------------------------------------------------------
# GET :3001/context. Default en código: 2000
TIMEOUT_CONTEXT_MS=
# POST :3003/coverage/check. Default en código: 3000
TIMEOUT_COVERAGE_MS=
# POST :3001/episodes. Default en código: 5000
TIMEOUT_EPISODE_MS=
# Deepgram TTS antes de caer a Polly. Default en código: 4000
TIMEOUT_TTS_MS=

# ------------------------------------------------------------------
# Paciente del demo
# ------------------------------------------------------------------
LOOP_PATIENT_ID=loop-demo-patient-001
NEXT_PUBLIC_LOOP_PATIENT_ID=loop-demo-patient-001
