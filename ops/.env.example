# =============================================================================
#  Loop — plantilla de variables de entorno.
#  Copiar a la RAIZ del repo como `.env` y rellenar. El `.env` real NUNCA
#  se commitea (esta en .gitignore). Este archivo va SIEMPRE con valores vacios.
# =============================================================================

# --- Medplum (Kiwis, loop-core :3001) ---------------------------------------
# URL base de la API de Medplum.
MEDPLUM_BASE_URL=
# Client ID del ClientApplication de Medplum.
MEDPLUM_CLIENT_ID=
# Client secret del ClientApplication de Medplum.
MEDPLUM_CLIENT_SECRET=
# Project ID de Medplum donde viven Patient, CarePlan y Encounter.
MEDPLUM_PROJECT_ID=

# --- Deepgram (Lewis, loop-voice :3002) -------------------------------------
# API key de Deepgram. Se usa en el SERVIDOR, nunca se expone al browser.
DEEPGRAM_API_KEY=
# Modelo de STT (Listen WebSocket). Default en codigo: nova-3.
DG_STT_MODEL=
# Idioma de STT. Default en codigo: multi (detecta espanol e ingles).
DG_STT_LANGUAGE=
# Voz de TTS (Aura-2). Default en codigo: aura-2-selena-es.
DG_TTS_VOICE=

# --- AWS (Lewis: Bedrock para el LLM, Polly como TTS de respaldo) -----------
# Region de AWS para Bedrock y Polly. Default en codigo: us-east-1.
AWS_REGION=
# Access key ID de AWS.
AWS_ACCESS_KEY_ID=
# Secret access key de AWS.
AWS_SECRET_ACCESS_KEY=
# Session token de AWS (solo si son credenciales temporales).
AWS_SESSION_TOKEN=
# Inference-profile ID de Bedrock que usa el agente. Nunca se hardcodea.
AGENT_MODEL_ID=
# Voz de AWS Polly para el fallback de TTS. Default en codigo: Lupe.
POLLY_VOICE=
# Motor de Polly. Default en codigo: generative.
POLLY_ENGINE=

# --- Anthropic (camino alternativo, NO usado: el primario es Bedrock) -------
# API key de Anthropic directa. Se deja documentada por el brief; sin valor.
ANTHROPIC_API_KEY=

# --- Stedi (Carlos, loop-coverage :3003) ------------------------------------
# API key de Stedi para la verificacion de elegibilidad (270/271).
STEDI_API_KEY=
# Payer ID de prueba de Stedi.
STEDI_TEST_PAYER_ID=

# --- URLs entre servicios ---------------------------------------------------
# loop-core (Kiwis). Default en codigo: http://localhost:3001
LOOP_CORE_URL=
# loop-voice (Lewis). Default en codigo: http://localhost:3002
LOOP_VOICE_URL=
# loop-coverage (Carlos). Default en codigo: http://localhost:3003
LOOP_COVERAGE_URL=

# --- IDs fijos del demo -----------------------------------------------------
# Paciente unico del demo. Default en codigo: loop-demo-patient-001
LOOP_PATIENT_ID=

# --- Puertos ----------------------------------------------------------------
# Puerto de loop-voice. Default en codigo: 3002. loop-voice IGNORA la variable
# generica `PORT` a proposito: en el .env real vale 8787 para otro proceso.
VOICE_PORT=
# Host de bind de loop-voice. Default en codigo: 0.0.0.0
VOICE_HOST=

# --- Palancas de integracion ------------------------------------------------
# `true` (default) => los clientes leen de shared/fixtures/ en vez de hacer HTTP.
# Solo se apaga poniendo literalmente `false`.
USE_MOCKS=
# Nivel de log de loop-voice. Default en codigo: info
LOG_LEVEL=

# --- Timeouts de llamadas salientes (ms) ------------------------------------
# GET :3001/context. Default en codigo: 2000
TIMEOUT_CONTEXT_MS=
# POST :3003/coverage/check. Default en codigo: 3000
TIMEOUT_COVERAGE_MS=
# POST :3001/episodes. Default en codigo: 5000
TIMEOUT_EPISODE_MS=
# Deepgram TTS antes de caer a Polly. Default en codigo: 4000
TIMEOUT_TTS_MS=
