# Loop — variables de entorno compartidas.
#
#   cp ops/.env.example .env
#
# Los nombres son idénticos en los cuatro servicios. Si cambias uno, cambia
# también en los otros briefs — está en la sección 3 de los tres planes.

# ------------------------------------------------------------------
# La palanca de integración
# ------------------------------------------------------------------
# true  → cada servicio lee de shared/fixtures/ en vez de llamar a los otros.
#         Nadie se bloquea esperando a que otro termine.
# false → llamadas HTTP reales entre servicios.
USE_MOCKS=true

# ------------------------------------------------------------------
# Medplum (Kiwis · loop-core)
# ------------------------------------------------------------------
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
MEDPLUM_PROJECT_ID=

# ------------------------------------------------------------------
# Deepgram (Lewis · loop-voice)
# ------------------------------------------------------------------
DEEPGRAM_API_KEY=

# ------------------------------------------------------------------
# Stedi (Carlos · loop-coverage)
# ------------------------------------------------------------------
# Sin STEDI_API_KEY el servicio arranca igual, en modo mock, y lo dice en
# /healthz. Eso es deliberado: nadie debe quedarse bloqueado esperando el
# alta de Stedi.
STEDI_API_KEY=
STEDI_ENV=sandbox

# Payer y miembro de prueba del sandbox. Sale de la consola de Stedi.
STEDI_TEST_PAYER_ID=
STEDI_TEST_PAYER_NAME=Test Payer Inc
STEDI_TEST_MEMBER_ID=
STEDI_TEST_MEMBER_FIRST_NAME=Alex
STEDI_TEST_MEMBER_LAST_NAME=Rivera
STEDI_TEST_MEMBER_DOB=1992-03-14

# NPI del proveedor que hace la consulta de elegibilidad.
STEDI_PROVIDER_NPI=1999999984
STEDI_PROVIDER_ORG_NAME=Loop Health Demo

# ------------------------------------------------------------------
# LLM (Lewis · loop-voice)
# ------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------
# URLs entre servicios
# ------------------------------------------------------------------
LOOP_CORE_URL=http://localhost:3001
LOOP_VOICE_URL=http://localhost:3002
LOOP_COVERAGE_URL=http://localhost:3003

# El dashboard corre en el navegador: necesita el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_LOOP_CORE_URL=http://localhost:3001
NEXT_PUBLIC_LOOP_VOICE_URL=http://localhost:3002
NEXT_PUBLIC_LOOP_COVERAGE_URL=http://localhost:3003

# Modo respaldo del dashboard: si el wifi del hackathon muere, se pone en
# true y toda la vista corre desde shared/fixtures/.
NEXT_PUBLIC_USE_FIXTURES=false

# ------------------------------------------------------------------
# Paciente del demo
# ------------------------------------------------------------------
LOOP_PATIENT_ID=loop-demo-patient-001
NEXT_PUBLIC_LOOP_PATIENT_ID=loop-demo-patient-001
